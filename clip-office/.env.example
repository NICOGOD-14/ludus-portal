# Ludus Clip Office — configuración (también puedes poner estas claves desde Ajustes en la app)
PORT=4321
# HOST=0.0.0.0            # descomenta para abrirla desde otro dispositivo de tu red (¡no la expongas a internet sin contraseña!)
# PUBLIC_URL=http://localhost:4321   # cámbialo si usas otro dominio/puerto (necesario para el OAuth de YouTube)

# Cerebro de los agentes (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# YouTube Data API v3 (estadísticas + búsqueda Creative Commons) — https://console.cloud.google.com
YOUTUBE_API_KEY=
# OAuth para publicar en tu canal (tipo "Aplicación web", URI de redirección: http://localhost:4321/api/youtube/callback)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Opcionales
OPENAI_API_KEY=            # transcripción Whisper si el video no trae subtítulos
PEXELS_API_KEY=            # fotos de stock gratis
TIKTOK_ACCESS_TOKEN=       # métricas de TikTok (Display API)
INSTAGRAM_ACCESS_TOKEN=    # métricas de Instagram (Graph API, cuenta profesional)
INSTAGRAM_USER_ID=
YTDLP_COOKIES_FILE=        # ruta a cookies.txt si YouTube pide verificar que no eres un bot
